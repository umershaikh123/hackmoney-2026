# GhostVault Solver Agent — Environment Variables

# Required: Solver wallet private key (with 0x prefix)
SOLVER_PRIVATE_KEY=0x...

# Required: Base RPC URL (Alchemy, Infura, etc.)
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Required: Deployed GhostVaultHook contract address
HOOK_ADDRESS=0x...

# Optional: Chain ID (8453 = Base mainnet, 84532 = Base Sepolia)
CHAIN_ID=8453

# Optional: Polling interval in milliseconds (default: 12000 = ~1 block)
POLL_INTERVAL_MS=12000

# Optional: How far back to scan for events (default: 50000 blocks)
LOOKBACK_BLOCKS=50000

# ── x402 Gateway (optional) ──

# If set, agent routes execution through the x402 gateway instead of direct on-chain calls
GATEWAY_URL=http://localhost:4020

# Gateway port (default: 4020)
GATEWAY_PORT=4020

# Gateway execution fee in USDC (default: $0.01)
GATEWAY_FEE=$0.01

# Coinbase Developer Platform credentials (for x402 payment verification)
# Get these from https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
