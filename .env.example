# GhostVault Protocol — Environment Variables
# Copy to .env.local and fill in your values.

# Deployer wallet private key (for forge script --broadcast)
DEPLOYER_PRIVATE_KEY=

# Alchemy API key
ALCHEMY_KEY=

# RPC endpoints
BASE_MAINNET_RPC=https://base-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>
BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>

# Block explorer verification
ETHERSCAN_API_KEY=
